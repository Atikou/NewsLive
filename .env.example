DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# AI_API_FORMAT=openai
# DEEPSEEK_THINKING_MODE=disabled

DAY_APP_PUSH_URL=https://api.day.app/your_push_key/
NTFY_PUSH_URL=https://ntfy.example.com/your_topic
# 私有 ntfy 主题或需登录的实例：Bearer token（可选）
# NTFY_BEARER_TOKEN=

# 可选：覆盖业务时区与公开榜单兼容接口。
# NEWS_TIMEZONE=Asia/Shanghai
# RANKINGS_API_URL=https://newsnow.busiyi.world/api/s

# 默认只在本机可访问。要在局域网/公网监听时再显式修改 HOST。
HOST=127.0.0.1
PORT=5178
# HOST 不是 127.0.0.1/::1/localhost 时必填，用于保护 POST /api/refresh。
# NEWSLIVE_ADMIN_TOKEN=
